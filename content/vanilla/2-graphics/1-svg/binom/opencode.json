{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["amazon-bedrock"],
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "find *": "allow",
      "git *": "deny",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "rm *": "deny",
      "npm *": "ask",
      "npm install *": "allow",
      "npm list": "allow",
      "npm run *": "deny",
      "npx biome": "allow",
      "tsc --noEmit *": "allow",
      "sort *": "allow",
      "tail *": "deny",
      "wc *": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "models": {},
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "https://api.anthropic.com/v1"
      }
    }
  }
}
