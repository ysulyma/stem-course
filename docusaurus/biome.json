{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							":NODE:",
							":BLANK_LINE:",

							":PACKAGE:",
							":BLANK_LINE:",

							":ALIAS:",
							":BLANK_LINE:",

							["../**", "!**/*.css", "!**/*.json", "!**/*.scss"],
							":BLANK_LINE:",

							["./**", "!**/*.css", "!**/*.json", "!**/*.scss"],
							":BLANK_LINE:",

							["**/*.css", "**/*.scss"],
							":BLANK_LINE:",

							"**/*.json"
						]
					}
				},
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "space"
		}
	},

	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!build",
			"!static/content/framework",
			"!.docusaurus",
			"!.firebase",
			"!**/package.json",
			"!**/package-lock.json",
			"!**/node_modules"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"attributePosition": "auto",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
